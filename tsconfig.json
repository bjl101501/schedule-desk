{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "$lib": ["./src-web/src/lib"],
      "$lib/*": ["./src-web/src/lib/*"]
    }
  },
  "include": [
    "src-web/src/**/*.ts",
    "src-web/src/**/*.svelte",
    "vite.config.ts"
  ],
  "exclude": ["src-web/build/**", "node_modules", "src-web/src/**/*.test.ts"]
}
